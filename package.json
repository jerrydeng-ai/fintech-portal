{
  "name": "kyc-review-queue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-env.mjs && prisma generate",
    "predev": "node scripts/ensure-env.mjs && prisma migrate deploy && tsx prisma/seed.ts --if-empty",
    "dev": "next dev",
    "build": "next build",
    "prestart": "prisma migrate deploy && tsx prisma/seed.ts --if-empty",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "next": "15.5.27",
    "prisma": "6.19.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
